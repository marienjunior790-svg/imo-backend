# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://immotec:immotec_dev@localhost:5432/immo_tec?schema=public"

# JWT
JWT_ACCESS_SECRET=immo-tec-dev-access-secret-key-32chars!!
JWT_REFRESH_SECRET=immo-tec-dev-refresh-secret-key-32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (recommandé en prod durable)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Si Cloudinary absent : stocker PDF/images sur disque (/uploads). Défaut true.
ALLOW_LOCAL_UPLOADS=true
# URL publique API (liens PDF absolus en fallback local) — ex. https://imo-backend-….up.railway.app
# PUBLIC_API_URL=

# App
DEFAULT_CURRENCY=XAF
DEFAULT_CITY=Brazzaville
DEFAULT_COUNTRY=CG

# Intelligence ITC (secrets backend UNIQUEMENT — jamais Flutter/APK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
# AI_MODEL=              # optionnel, sinon OPENAI_MODEL
STT_PROVIDER=openai
TTS_PROVIDER=openai
AI_MAX_HISTORY=10
AI_PENDING_ACTION_TTL_MS=900000
AI_MEMORY_ENABLED=true
AI_SESSION_TTL_HOURS=24

# n8n Automation
N8N_ENABLED=false
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=immo-tec-automation-key-32chars-min

# CORS (production) — origines séparées par des virgules (frontend web)
# CORS_ORIGINS=https://app.example.com
# URL publique Railway (logs au démarrage)
# PUBLIC_API_URL=https://votre-api.up.railway.app
# Premier super-admin plateforme (créé une seule fois si aucun SUPER_ADMIN en base)
# BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@votre-domaine.cg
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=changez-moi-en-production

# P4 Identity & Security
PASSWORD_RESET_TTL_HOURS=1
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Mail — OBLIGATOIRE pour forgot-password / invitations (sinon HTTP 503)
# Option A — Resend (recommandé)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="ITC <noreply@votredomaine.com>"
# Option B — SMTP (Brevo / SendGrid / Mailgun / Gmail…)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ITC <noreply@votredomaine.com>"
# PUBLIC_APP_URL=https://app.itc.cg

# WhatsApp Business — Meta Cloud API (optionnel ; voir qa-e2e/WHATSAPP_ITC_SETUP.md)
# WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=                    # permanent system user token (jamais dans le repo)
# WHATSAPP_PHONE_NUMBER_ID=          # ID du numéro dans Meta Business
# WHATSAPP_BUSINESS_ACCOUNT_ID=      # optionnel (WABA)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=242  # Congo-Brazzaville
# WHATSAPP_TEMPLATE_NAME=            # si défini : envoi template (sinon texte libre, fenêtre 24h)
# WHATSAPP_TEMPLATE_LANGUAGE=fr


